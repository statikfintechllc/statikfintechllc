{
  "name": "sfti-web-templates",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern Web Template System for StatikFinTech LLC's Multi-Domain Infrastructure",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:static": "node static-server.js",
    "dev:all": "node develop.site.launch/dev-server.js",
    "dev:unified": "npm run dev:all",
    "build": "vite build",
    "build:all": "./build/build-all.sh",
    "build:clean": "./build/build-all.sh clean",
    "build:pwa": "./build/build-all.sh pwa-only",
    "build:static": "./build/build-all.sh static-only",
    "build:dev": "./build/build-all.sh dev",
    "build:prod": "./build/build-all.sh",
    "preview": "vite preview",
    "preview:all": "concurrently \"npm run preview\" \"npm run preview:dev-scanner\" \"npm run preview:server-scanner\"",
    "preview:dev-scanner": "cd dev.sfti-ai.org/IB-G.Scanner && npm run preview -- --port 4174",
    "preview:server-scanner": "cd server.sfti-ai.org/IB-G.Scanner && npm run preview -- --port 4175",
    "install:all": "npm install && cd dev.sfti-ai.org/IB-G.Scanner && npm install && cd ../../server.sfti-ai.org/IB-G.Scanner && npm install",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public_html/dist/styles.css --watch",
    "build:dev-css": "tailwindcss -i ./src/styles/globals.css -o ./public_html/dev.sfti-ai.org/dist/styles.css --watch",
    "build:server-css": "tailwindcss -i ./src/styles/globals.css -o ./public_html/server.sfti-ai.org/dist/styles.css --watch",
    "lint": "echo 'Linting all projects...' && npm run lint:root && npm run lint:dev-scanner && npm run lint:server-scanner",
    "lint:root": "echo 'Root project has no linter configured'",
    "lint:dev-scanner": "cd dev.sfti-ai.org/IB-G.Scanner && npm run lint",
    "lint:server-scanner": "cd server.sfti-ai.org/IB-G.Scanner && npm run lint",
    "serve": "npx http-server dist -p 8080 -c-1",
    "serve:dev": "npx http-server dist -p 8080 -c-1 --cors"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "http-proxy-middleware": "^3.0.5",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "keywords": [
    "shadcn",
    "tailwind",
    "react",
    "typescript",
    "vite",
    "pwa"
  ],
  "author": "StatikFinTech LLC",
  "license": "MIT"
}
